# Advent-Tech auth / credits / payments backend. Copy to backend/.env and fill in.
# Use NEW values for everything. Never reuse MNR's database, secrets or keys:
# that is what keeps Advent's users and credits separate.

PORT=5000
NODE_ENV=production

# --- Database (Advent's own) ---
MONGODB_URL=mongodb+srv://<user>:<password>@<advent-cluster>/advent_tester
# Mobile-testing sessions; defaults to MONGODB_URL when blank
MOBILE_DB_URL=

# --- Secrets (generate fresh, e.g. `openssl rand -hex 48`) ---
# Must be the SAME value configured on Advent's web, perf and DB testing engines.
JWT_SECRET=
# Shared with Advent's engines for /internal/* calls (x-internal-secret header)
INTERNAL_API_SECRET=

# --- URLs ---
# Advent frontend, used in email links and logos (e.g. https://app.adventglobal.com)
FRONTEND_URL=
# Allowed browser origins, comma-separated (localhost is always allowed)
CORS_ORIGINS=
# Advent web engine's terminate endpoint (stops a user's old session on re-login)
AI_BACKEND_API_TERMINATE=

# --- Mail (SMTP) ---
MAIL_HOST=
MAIL_USER=
MAIL_PASS=

# --- Razorpay (Advent's account) ---
# Webhook URL to set in the Razorpay dashboard: <backend>/api/payments/webhook
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Credits ---
CREDITS_ENFORCED=true
# Run billing jobs on exactly ONE backend instance
CREDIT_JOBS_ENABLED=true

# Optional: custom DNS resolvers for mongodb+srv lookups, comma-separated
DNS_SERVERS=
