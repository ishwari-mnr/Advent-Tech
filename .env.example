# Advent-Tech frontend. Copy to .env and fill in.
# Every URL below must point at an ADVENT deployment, never at MNR's.

# Advent auth / credits / payments backend (this repo's backend/). Must end in /api.
REACT_APP_AUTH_URL=http://localhost:5000/api

# Contact form endpoint
REACT_APP_API_URL=

# Testing engines (Advent's own deployments)
REACT_APP_AI_WEB_TESTER_BACKEND_URL=
REACT_APP_AI_SPEC_TESTER_BACKEND_URL=
REACT_APP_AI_API_TESTER_BACKEND_URL=
REACT_APP_AI_REGRESSION_TESTER_BACKEND_URL=
REACT_APP_AI_MOBILE_TESTER_BACKEND_URL=
REACT_APP_AI_MOBILE_UPLOAD_URL=
REACT_APP_AI_MOBILE_TESTER_BACKEND_WS_URL=
REACT_APP_PERF_TESTER_BACKEND_URL=
REACT_APP_DB_TESTER_BACKEND_URL=
REACT_APP_CODE_TESTER_BACKEND_URL=
REACT_APP_SECURITY_TESTING_URL=

# Optional: INR per USD used for price display
REACT_APP_FX_INR_PER_USD=
